# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JAMENDO: Client id for Jamendo API track search (Layer 2 provider fleet).
# Register at https://devportal.jamendo.com/
VITE_JAMENDO_CLIENT_ID="MY_JAMENDO_CLIENT_ID"

# Tier 3/4 extraction backend (default port 3001) — run: npm run dev:tier34
TIER34_PORT=3001

# Sandbox Indexer is built-in (yt-dlp + Archive.org). Optional external indexer + Real-Debrid:
PROWLARR_URL=
PROWLARR_API_KEY=
REALDEBRID_API_KEY=

# Tier 3/4 blob storage root (optional — default: tier34-server/storage/)
# TIER34_STORAGE_PATH=D:\Music\SovereignBlobs

# Folder watch import — OFF by default (chokidar depth-99). Opt in explicitly:
# TIER34_INGEST_WATCHER=1
# TIER34_WATCH_PATH=D:\Music

# OpenSubsonic read-only API (Symfonium/Feishin) — default user/password: sandbox/sandbox
# SUBSONIC_USER=sandbox
# SUBSONIC_PASSWORD=sandbox
# SUBSONIC_BASE_URL=http://192.168.1.10:3001
# SUBSONIC_API_ENABLED=true
TIER34_CORS_ORIGIN=http://localhost:3002
TIER34_DEFENSE_PROTOCOL=true
# Interminable Tide anti-scraper stream trap — chaff|jitter|both|off (see docs/interminable-tide.md)
TIER34_INTERMINABLE_TIDE=chaff
# Require X-Sandbox-Client on stream endpoints (stricter; Subsonic auth still bypasses)
# TIER34_DEFENSE_STRICT=false

# Aggressive client prefetch — max upstream size for GET /api/stream/full (MB)
# TIER34_STREAM_FULL_MAX_MB=150

# Overlay stack (Headscale + Tailscale sidecar) — see .env.overlay.example and docs/overlay-network.md
# HEADSCALE_HTTP_PORT=8080
# HEADSCALE_LOGIN_SERVER=http://headscale:8080
# TAILSCALE_AUTHKEY=
# TAILSCALE_HOSTNAME=sandbox-tier34

# DLNA/UPnP MediaServer SSDP — OFF by default (see docs/dlna-mediaserver.md)
# TIER34_DLNA=1
# (alias still accepted: DLNA_MEDIASERVER=1)
# DLNA_BASE_URL=http://192.168.1.42:3001
# DLNA_FRIENDLY_NAME=Sovereign Music Locker

# Podcast mirror / Whisper schedulers — OFF by default (idle cost)
# PODCAST_MIRROR_ENABLED=1
# PODCAST_WHISPER_ENABLED=1

# Sandbox Cast custom receiver (optional — TV visualizer on Cast receivers)
# Register at https://console.cast.google.com/ with receiver URL: https://your-host/cast-receiver.html
# Without this, audio casting still works via the default media receiver.
VITE_CAST_RECEIVER_APP_ID=

# yt-dlp binary for Tier 3 proxy resolve (full streams). Install: pip install yt-dlp
# Auto-fallback tries: yt-dlp, python -m yt_dlp, python3 -m yt_dlp
# Windows example: YTDLP_PATH=python -m yt_dlp
YTDLP_PATH=

# Spotify OAuth (optional — demo OAuth works without these)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://localhost:3001/api/oauth/spotify/callback"
OAUTH_REDIRECT_URI="http://localhost:3001/api/oauth/spotify/callback"

# TIDAL playlist import (optional).
#
# Leave unset and the feature is simply absent. These are embedded in the client bundle at build
# time, so treat them as public: register your own app rather than reusing anyone else's, and
# never point a published build at credentials you care about. The durable fix is OAuth with PKCE,
# which needs no secret in the client at all.
VITE_TIDAL_CLIENT_ID=
VITE_TIDAL_CLIENT_SECRET=

# Acquisition resolvers (on-device yt-dlp and similar) start switched on.
#
# Leave unset for any build you distribute: resolvers register but stay off until the user turns
# them on in Settings, having seen what they are. Set to true only for personal or self-host
# builds where the operator has already decided. An explicit user choice always overrides this.
VITE_ACQUISITION_DEFAULT_ON=

# --- TIDAL via Sandbox Server (preferred) ---
#
# Set these on the tier34 server instead of the client and the credential never ships in a build.
# The app asks its own server for the playlist; the server talks to TIDAL. Nothing to extract from
# an APK, because nothing is in it. This is the recommended arrangement — the VITE_TIDAL_* pair
# above exists only for someone running no server at all.
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
