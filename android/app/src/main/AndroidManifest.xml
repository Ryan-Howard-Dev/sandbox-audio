<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Leanback TV: touchscreen optional, leanback software feature -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:banner="@drawable/tv_banner">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:supportsPictureInPicture="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sandboxmusic" android:host="player" android:path="/home" />
            </intent-filter>
            <!-- Automation / phone E2E gate: sandboxmusic://e2e/* deep links -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sandboxmusic" android:host="e2e" android:pathPrefix="/" />
            </intent-filter>
            <!-- External playlist import: sandboxmusic://import/playlist?text=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sandboxmusic" android:host="import" android:pathPrefix="/playlist" />
            </intent-filter>
            <!-- Share playlist URL from Tidal, Spotify, etc. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".MediaPlaybackForegroundService"
            android:description="@string/media_playback_service_description"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
        >
            <!--
                Required for lock-screen / headset transport. Without a MEDIA_BUTTON filter the
                session reports mediaButtonReceiver=null and only receives buttons while the app
                is the most-recently-active session; Tidal and YouTube Music both register one.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true"
        >
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <service
            android:name=".DownloadForegroundService"
            android:description="@string/download_service_description"
            android:exported="false"
            android:foregroundServiceType="dataSync"
        />

        <service
            android:name=".SandboxMediaBrowserService"
            android:exported="true"
            android:label="@string/android_auto_browse_service_label"
        >
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!--
          The playing waveform, as a live wallpaper.

          Android gives no app any way to draw on the lock screen — it belongs to the system, and
          the media card on it is a notification rather than a surface. A live wallpaper is the one
          surface that renders full-screen behind that card, so this is the only honest route to
          the waveform covering the lock screen.

          exported and with BIND_WALLPAPER because the system's wallpaper host binds it; that
          permission is what stops anything other than the system doing so.
        -->
        <service
            android:name=".WaveformWallpaperService"
            android:exported="true"
            android:label="@string/waveform_wallpaper_label"
            android:permission="android.permission.BIND_WALLPAPER"
        >
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/waveform_wallpaper"
            />
        </service>

        <!--
          Alternative launcher icons.

          Android has no API for changing an app icon directly. The only way is to declare one
          activity-alias per icon and enable exactly one at a time, which is what AppIconPlugin
          does. Exactly one must always be enabled or the app disappears from the launcher.

          Switching force-stops the app: changing component enablement is what Android does to
          a package it is reconfiguring. That is not a bug to fix, it is the cost of the
          feature, and the UI says so before it happens.
        -->

        <!-- Alternative launcher icon: Blood Orange. Disabled until chosen in Settings. -->
        <activity-alias
            android:name=".IconAliasBloodorange"
            android:targetActivity=".MainActivity"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher_bloodorange"
            android:roundIcon="@mipmap/ic_launcher_bloodorange"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Alternative launcher icon: Graphite. Disabled until chosen in Settings. -->
        <activity-alias
            android:name=".IconAliasGraphite"
            android:targetActivity=".MainActivity"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher_graphite"
            android:roundIcon="@mipmap/ic_launcher_graphite"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Alternative launcher icon: Terminal. Disabled until chosen in Settings. -->
        <activity-alias
            android:name=".IconAliasTerminal"
            android:targetActivity=".MainActivity"
            android:label="@string/title_activity_main"
            android:icon="@mipmap/ic_launcher_terminal"
            android:roundIcon="@mipmap/ic_launcher_terminal"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc"
        />

        <receiver android:name=".MediaNotificationReceiver" android:exported="false" />

        <receiver android:name=".WakeAlarmReceiver" android:exported="false" />

        <receiver android:name=".WakeAlarmBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".FollowedReleaseReceiver" android:exported="false" />

        <receiver android:name=".FollowedReleaseBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name=".LockerBlobContentProvider"
            android:authorities="${applicationId}.locker"
            android:exported="false"
            android:grantUriPermissions="true"
        />
    </application>

    <!-- Permissions -->

    <!--
      Camera, for reading the barcode on a record sleeve and nothing else.

      ML Kit decodes on the device: no frame is uploaded, no image is stored, and the only thing
      that leaves as a result is the thirteen digits printed on the packaging, sent to MusicBrainz
      when a lookup is asked for. The permission is requested when the shelf scanner is opened and
      never on launch, so an install that never touches the shelf is never asked.

      The plugin does not declare this itself — it expects the app to — so without this line the
      scanner asks for a permission that cannot be granted and fails at runtime.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Not required: a device with no camera still installs, and typing the barcode still works. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
    />
</manifest>
